# Copy this file to ".env" and fill in your key, OR set the variable
# directly in your environment / hosting settings (e.g. as a Hugging Face
# Space secret). NEVER commit a real key to git.
#
# Required only for the "Generative AI" answer mode (Google Gemini).
# Without it, Generative AI mode returns HTTP 503 and Extractive mode
# keeps working normally.
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
